<!DOCTYPE html>
<html lang="en" class="govuk-template">

<head>
    <title>GOV.UK - Global search spike</title>

    <%- include('../partials/headercss.ejs') %>
</head>

<body class="govuk-template__body app-example-page">
    <script>
        document.body.className = document.body.className ?
            document.body.className + ' js-enabled' :
            'js-enabled';

    </script>

    <%- include('../partials/cookies-consent.ejs') %>
    <%- include('../partials/header.ejs') %>

    <div class="govuk-width-container">
        <%- include('../partials/banner.ejs') %>
        <a href="/" class="govuk-back-link">Back home</a>
        <main id="main-content" role="main">
            <div class="govuk-main-wrapper">

                <% const totalSchemes = schemesResults && schemesResults.totalSearchResults && schemesResults.totalSearchResults.toLocaleString('en') || 0; %>
                <% const totalAwards = awardsResults && awardsResults.totalSearchResults && awardsResults.totalSearchResults.toLocaleString('en') || 0; %>
                <% const totalMfa = mfaResults && mfaResults.totalSearchResults && mfaResults.totalSearchResults.toLocaleString('en') || 0; %>

                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-full">
                        <h1 class="govuk-heading-l">Global search</h1>
                    </div>
                </div>

                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-full">
                        <a href="/awards?keyword=<%= filters.keyword || '' %>">Total awards: <%= totalAwards %></a>
                    </div>
                </div>

                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-full">
                        <a href="/schemes?keyword=<%= filters.keyword || '' %>">Total schemes: <%= totalSchemes %></a>
                    </div>
                </div>

                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-full">
                        <a href="/mfaawards?keyword=<%= filters.keyword || '' %>">Total MFA/SPEIA: <%= totalMfa %></a>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <%- include('../partials/footer.ejs') %>
</body>

</html>
