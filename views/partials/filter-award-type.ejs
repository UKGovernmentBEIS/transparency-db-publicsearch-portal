<%
    const awardTypes = [
    "Standalone award",
    "Award under a scheme"
    ];

    const awardTypesArray = Array.isArray(filters.awardType) ? filters.awardType.map(l => l.toLowerCase()) : [(filters.awardType || "").toLowerCase()];
%>

<div class="govuk-form-group">
    <label class="govuk-label govuk-label--s" for="award-type-checkbox">
      Award type
    </label>

    <div class="govuk-checkboxes govuk-checkboxes--small filter-scroll-box" id="award-type-checkbox">
 
      <% awardTypes.forEach((awardType, index) => { %>
        <div class="govuk-checkboxes__item">
          <input class="govuk-checkboxes__input awardType-checkbox"  id="award-type-<%=index%>" name="awardType" type="checkbox" value="<%=awardType%>"
          <%= awardTypesArray.includes(awardType.toLowerCase()) ? "checked" : "" %>
          >

          <label class="govuk-label govuk-checkboxes__label" for="award-type-<%=index%>">
            <%=awardType%>
          </label>
        </div>
      <% }) %>
    </div>
</div>