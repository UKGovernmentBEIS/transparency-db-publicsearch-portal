<%
    const mfaAssistanceTypes = ["MFA", "SPEI"];
    const selectedAssistance = (filters.mfaAssistance || "").toLowerCase();
%>

<div class="govuk-form-group">
    <label class="govuk-label govuk-label--s" for="mfa-assistance-radio">
        Assistance type
    </label>
    
    <div class="filter-background-override">
        <div class="govuk-radios govuk-radios--inline govuk-radios--small" id="mfa-assistance-radio">
            <% mfaAssistanceTypes.forEach(assistance => { %>
                <div class="govuk-radios__item">
                    <input class="govuk-radios__input" id="<%= assistance %>" name="mfaAssistance" type="radio" value="<%= assistance %>"
                        <%= selectedAssistance === assistance.toLowerCase() ? "checked" : "" %>
                    >
                    <label class="govuk-label govuk-radios__label" for="<%= assistance %>">
                        <%= assistance %>
                    </label>
                </div>
            <% }) %>
        </div>
    </div>
</div>