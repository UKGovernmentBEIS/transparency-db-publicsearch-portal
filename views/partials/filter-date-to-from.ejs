<%
  const fromFieldId = `${filterIdPrefix}-filter-from-day`;
  const toFieldId = `${filterIdPrefix}-filter-to-day`;

  const fromError = errors.find(error => error.field === fromFieldId);
  const toError = errors.find(error => error.field === toFieldId);

  const hasError = Boolean(fromError || toError);
%>

<div class="govuk-date-input filter-date-input" id="<%=filterIdPrefix%>-date-input">
  <div class="govuk-form-group <%= fromError || toError ? 'govuk-form-group--error' : '' %>"> 
    <label class="govuk-label govuk-label--s " for="<%=filterIdPrefix%>-date-input">
      <%= filterTitle %>
    </label>

    <div class="filter-background-override">
      <% if (fromError) { %>
        <p id="<%= fromFieldId %>-error" class="govuk-error-message">
          <span class="govuk-visually-hidden">Error:</span>
          <%= fromError.errorMsg %>
        </p>
      <% } %>

    <label class="govuk-label govuk-label--xs" id="<%=filterIdPrefix%>-from-date-label">
        From
      </label>
      <div class="govuk-hint">
        For example, 27 03 2007
      </div>
      <div class="govuk-date-input" id="<%=filterIdPrefix%>-from-date-input">
        <div class="govuk-date-input__item filter-date-input__item">
          <div class="govuk-form-group">
            <label class="govuk-label govuk-date-input__label--s" for="<%=filterIdPrefix%>-filter-from-day">
              Day
            </label>
            <input class="govuk-input govuk-date-input__input govuk-input--width-2 <%= fromError ? 'govuk-input--error' : '' %>" id="<%=filterIdPrefix%>-filter-from-day" name="<%=filterIdPrefix%>FromDay" type="text" placeholder="DD" maxlength="2" pattern="(3[01]|[12][0-9]|0[1-9])" inputmode="numeric" value="<%= filters[filterIdPrefix + 'FromDay'] %>">
          </div>
        </div>
        <div class="govuk-date-input__item filter-date-input__item">
          <div class="govuk-form-group">
            <label class="govuk-label govuk-date-input__label--s" for="<%=filterIdPrefix%>-filter-from-month">
              Month
            </label>
            <input class="govuk-input govuk-date-input__input  govuk-input--width-2 <%= fromError ? 'govuk-input--error' : '' %>" id="<%=filterIdPrefix%>-filter-from-month" name="<%=filterIdPrefix%>FromMonth" type="text" placeholder="MM" maxlength="2" pattern="(1[0-2]|0[1-9])" inputmode="numeric" value="<%= filters[filterIdPrefix + 'FromMonth'] %>">
          </div>
        </div>
        <div class="govuk-date-input__item filter-date-input__item">
          <div class="govuk-form-group">
            <label class="govuk-label govuk-date-input__label--s" for="<%=filterIdPrefix%>-filter-from-year">
              Year
            </label>
            <input class="govuk-input govuk-date-input__input  govuk-input--width-4 <%= fromError ? 'govuk-input--error' : '' %>" id="<%=filterIdPrefix%>-filter-from-year" name="<%=filterIdPrefix%>FromYear" type="text" placeholder="YYYY" maxlength="4" pattern="[0-9]{4}" inputmode="numeric" value="<%= filters[filterIdPrefix + 'FromYear'] %>">
          </div>
        </div>
      </div>

      <% if (toError) { %>
        <p id="<%= toFieldId %>-error" class="govuk-error-message">
          <span class="govuk-visually-hidden">Error:</span>
          <%= toError.errorMsg %>
        </p>
      <% } %>
    <label class="govuk-label govuk-label--xs" id="<%=filterIdPrefix%>-to-date-label">
        To
      </label>
      <div class="govuk-hint">
        For example, 27 03 2007
      </div>
      <div class="govuk-date-input" id="<%=filterIdPrefix%>-to-date-input">
        <div class="govuk-date-input__item filter-date-input__item">
          <div class="govuk-form-group">
            <label class="govuk-label govuk-date-input__label--s" for="<%=filterIdPrefix%>-filter-to-day">
              Day
            </label>
            <input class="govuk-input govuk-date-input__input govuk-input--width-2 <%= toError ? 'govuk-input--error' : '' %>" id="<%=filterIdPrefix%>-filter-to-day" name="<%=filterIdPrefix%>ToDay" type="text" placeholder="DD" maxlength="2" pattern="(3[01]|[12][0-9]|0[1-9])" inputmode="numeric" value="<%= filters[filterIdPrefix + 'ToDay'] %>">
          </div>
        </div>
        <div class="govuk-date-input__item filter-date-input__item">
          <div class="govuk-form-group">
            <label class="govuk-label govuk-date-input__label--s" for="<%=filterIdPrefix%>-filter-to-month">
              Month
            </label>
            <input class="govuk-input govuk-date-input__input govuk-input--width-2 <%= toError ? 'govuk-input--error' : '' %>" id="<%=filterIdPrefix%>-filter-to-month" name="<%=filterIdPrefix%>ToMonth" type="text" placeholder="MM" maxlength="2" pattern="(1[0-2]|0[1-9])" inputmode="numeric" value="<%= filters[filterIdPrefix + 'ToMonth'] %>">
          </div>
        </div>
        <div class="govuk-date-input__item filter-date-input__item">
          <div class="govuk-form-group">
            <label class="govuk-label govuk-date-input__label--s" for="<%=filterIdPrefix%>-filter-to-year">
              Year
            </label>
            <input class="govuk-input govuk-date-input__input govuk-input--width-4 <%= toError ? 'govuk-input--error' : '' %>" id="<%=filterIdPrefix%>-filter-to-year" name="<%=filterIdPrefix%>ToYear" type="text" placeholder="YYYY" maxlength="4" pattern="[0-9]{4}" inputmode="numeric" value="<%= filters[filterIdPrefix + 'ToYear'] %>">
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
