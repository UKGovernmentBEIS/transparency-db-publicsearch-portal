<%
  const fromFieldId = `${filterIdPrefix}-from-amount-input`;
  const toFieldId = `${filterIdPrefix}-to-amount-input`;

  const fromError = errors.find(error => error.field === fromFieldId);
  const toError = errors.find(error => error.field === toFieldId);

  const hasError = Boolean(fromError || toError);
%>

<div class="govuk-form-group <%= hasError ? 'govuk-form-group--error' : '' %>">
  <label class="govuk-label govuk-label--s">
    <%= filterTitle %>
  </label>

  <% if (fromError) { %>
    <p id="<%= fromFieldId %>-error" class="govuk-error-message">
      <span class="govuk-visually-hidden">Error:</span>
      <%= fromError.errorMsg %>
    </p>
  <% } %>
  
  <label class="govuk-label govuk-label--xs govuk-!-margin-top-2" for="<%=fromFieldId%>">
    From
  </label>
  <div id="<%=filterIdPrefix%>-from-hint" class="govuk-hint">
      For example, 1000000
  </div>
  <div class="govuk-input__wrapper">
      <div class="govuk-input__prefix" aria-hidden="true">£</div>
      <input class="govuk-input <%= fromError ? 'govuk-input--error' : '' %>" id="<%=fromFieldId%>" name="<%=filterIdPrefix%>FromAmount" type="number" min="0" step="1" value="<%= filters[filterIdPrefix + "FromAmount"]%>">
  </div>

  <% if (toError) { %>
    <p id="<%= toFieldId %>-error" class="govuk-error-message">
      <span class="govuk-visually-hidden">Error:</span>
      <%= toError.errorMsg %>
    </p>
  <% } %>

  <label class="govuk-label govuk-label--xs govuk-!-margin-top-2" for="<%=toFieldId%>">
    To
  </label>
  <div id="<%=filterIdPrefix%>-to-hint" class="govuk-hint">
      For example, 2000000
  </div>
  <div class="govuk-input__wrapper">
      <div class="govuk-input__prefix" aria-hidden="true">£</div>
      <input class="govuk-input <%= toError ? 'govuk-input--error' : '' %>" id="<%=toFieldId%>" name="<%=filterIdPrefix%>ToAmount" type="number" min="0" step="1" value="<%= filters[filterIdPrefix + "ToAmount"]%>">
  </div>
</div>